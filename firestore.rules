rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Verified Admin: checked against /admins/{uid} marker, users collection role, or owner email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)riskiramad3@gmail\\.com')) ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)admin.*@.*'))
      );
    }

    function isParentMapAllowed(mapId) {
      return isValidId(mapId) && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/maps/$(mapId)) && 
         (
           request.auth.uid in get(/databases/$(database)/documents/maps/$(mapId)).data.allowedOfficerIds ||
           get(/databases/$(database)/documents/maps/$(mapId)).data.createdBy == request.auth.uid
         ))
      );
    }

    // App global settings (header logos, agency branding)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins marker collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == adminId
      );
    }

    // User profiles & permissions
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.isActive == true)
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'allowedMapIds', 'isActive']))
      );
      allow delete: if isAdmin();
    }

    // Tactical Medical Maps
    // Signed-in users can view map directory to request sector access.
    // Sensitive operational unit details and risk zones inside subcollections are strictly protected by isParentMapAllowed.
    match /maps/{mapId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      // Units plotted on map: Admins have full CRUD; assigned Officers can ONLY read units (no manual plotting)
      match /units/{unitId} {
        allow read: if isSignedIn() && isParentMapAllowed(mapId);
        allow create, update, delete: if isAdmin();
      }

      // Risk zones plotted on map: Admins create, update, delete; all assigned users can view
      match /riskZones/{zoneId} {
        allow read: if isSignedIn() && isParentMapAllowed(mapId);
        allow create, update, delete: if isAdmin();
      }
    }

    // Realtime Officer GPS Telemetry
    match /officerLocations/{officerUid} {
      // Admins can read all officer locations.
      // Assigned officers can read their own location or locations on maps they are assigned to.
      allow read: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == officerUid ||
        (resource.data.mapId != null && isParentMapAllowed(resource.data.mapId))
      );

      // Officers can only write/update their own telemetry document using their authenticated UID
      allow create, update: if isSignedIn() && 
        request.auth.uid == officerUid &&
        request.resource.data.officerUid == request.auth.uid;

      // Only Admin or the Officer themselves can delete the telemetry document
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == officerUid);
    }

    // Map Access Requests
    match /accessRequests/{requestId} {
      // Officers can read their own requests; Admins can read all requests
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.officerUid == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );

      // Officers can create requests for their own UID with status 'pending'
      allow create: if isSignedIn() && 
        (request.resource.data.officerUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
        request.resource.data.status == 'pending';

      // Officers can re-submit rejected requests; Admins can approve or reject
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.officerUid == request.auth.uid || resource.data.userId == request.auth.uid) &&
          (request.resource.data.officerUid == request.auth.uid || request.resource.data.userId == request.auth.uid) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.mapId == resource.data.mapId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy', 'reviewedAt', 'reviewedByEmail'])
        )
      );

      allow delete: if isAdmin() || (
        isSignedIn() && 
        (resource.data.officerUid == request.auth.uid || resource.data.userId == request.auth.uid) && 
        resource.data.status == 'pending'
      );
    }
  }
}
