rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Verified Admin: checked against /admins/{uid} marker, users collection role, or owner email
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)riskiramad3@gmail\\.com')) ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)admin.*@.*'))
      );
    }

    function isParentMapAllowed(mapId) {
      return isValidId(mapId) && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/maps/$(mapId)) && 
         (
           request.auth.uid in get(/databases/$(database)/documents/maps/$(mapId)).data.allowedOfficerIds ||
           get(/databases/$(database)/documents/maps/$(mapId)).data.createdBy == request.auth.uid
         ))
      );
    }

    // App global settings (header logos, agency branding)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admins marker collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == adminId
      );
    }

    // User profiles & permissions
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.isActive == true)
      );
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'allowedMapIds', 'isActive']))
      );
      allow delete: if isAdmin();
    }

    // Tactical Medical Maps
    match /maps/{mapId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        (resource.data.allowedOfficerIds is list && request.auth.uid in resource.data.allowedOfficerIds) ||
        resource.data.createdBy == request.auth.uid
      );
      allow create, update, delete: if isAdmin();

      // Units plotted on map: Admins have full CRUD; assigned Officers can read and plot/update units
      match /units/{unitId} {
        allow read: if isSignedIn() && isParentMapAllowed(mapId);
        allow create, update: if isSignedIn() && isParentMapAllowed(mapId);
        allow delete: if isAdmin();
      }

      // Risk zones plotted on map: Admins create, update, delete; all assigned users can view
      match /riskZones/{zoneId} {
        allow read: if isSignedIn() && isParentMapAllowed(mapId);
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
